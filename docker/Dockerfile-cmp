# CMP image for ArgoCD. Neither binary is built here: both are pulled from
# their respective GitHub Release archives so there is exactly one canonical
# build per binary (goreleaser for the current version, the frozen v0.16.8
# archive for the legacy fallback). Building from source in this image used
# to produce a legacy binary whose bytes differed from the Release archive,
# which defeated hash-based integrity verification.

# Legacy binary: pulled once from the frozen v0.16.8 Release archive.
FROM docker.io/library/golang:1.27.1 AS legacyfetch
ARG LEGACY_ARCHIVE_SHA=2d30764bc3c64f28ddc28a59a3c8d2bfca7d7ef353e947439c07f65462239910
RUN curl -sfL https://github.com/noris-network/cuegen/releases/download/v0.16.8/cuegen_0.16.8_linux_amd64.tar.gz -o /tmp/legacy.tgz \
 && echo "${LEGACY_ARCHIVE_SHA}  /tmp/legacy.tgz" | sha256sum -c - \
 && tar xzf /tmp/legacy.tgz -C /tmp && mv /tmp/cuegen /tmp/cuegen_v0.16.8

# Current binary: pulled from the Release archive goreleaser just published.
# Verified against the checksums.txt goreleaser publishes beside it, so this
# stage needs no hardcoded digest the way the frozen legacy archive does - the
# expected value ships with the release it describes.
FROM docker.io/library/golang:1.27.1 AS curfetch
ARG VERSION
RUN set -eu; \
    archive="cuegen_${VERSION#v}_linux_amd64.tar.gz"; \
    base="https://github.com/noris-network/cuegen/releases/download/${VERSION}"; \
    cd /tmp; \
    curl -sfL "${base}/${archive}" -o "${archive}"; \
    curl -sfL "${base}/checksums.txt" -o checksums.txt; \
    grep " ${archive}\$" checksums.txt | sha256sum -c -; \
    tar xzf "${archive}" -C /tmp

FROM docker.io/library/debian:13-slim
COPY --from=legacyfetch /tmp/cuegen_v0.16.8 /bin/cuegen_v0.16.8
COPY --from=curfetch    /tmp/cuegen         /bin/cuegen
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
                ca-certificates \
                curl \
            && rm -rf /var/cache/apt/archives /var/lib/apt/lists/*
ENV CUE_CACHE_DIR=/tmp
# yq ships a multi-hash checksums file that is awkward to parse here, so the
# SHA-256 is pinned directly (as for the legacy archive above). Bump it
# together with the version in the URL.
ARG YQ_SHA=d56bf5c6819e8e696340c312bd70f849dc1678a7cda9c2ad63eebd906371d56b
RUN curl -sfL https://github.com/mikefarah/yq/releases/download/v4.53.2/yq_linux_amd64 -o /bin/yq \
 && echo "${YQ_SHA}  /bin/yq" | sha256sum -c - \
 && chmod 755 /bin/yq
COPY docker/plugin.yaml /home/argocd/cmp-server/config/plugin.yaml
